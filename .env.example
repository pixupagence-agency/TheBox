# APP_URL : adresse publique de l'application (liens dans les e-mails, retours Stripe).
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =========================================================================
# STRIPE PAYMENTS CONFIGURATION
# =========================================================================
# 1. Clé secrète Stripe (tableau de bord Stripe > Développeurs > Clés API)
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_SECRET_KEY"

# 2. Clé publique Stripe (accessible côté client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_STRIPE_PUBLISHABLE_KEY"

# 3. Secret de signature du Webhook Stripe (Stripe > Développeurs > Webhooks)
STRIPE_WEBHOOK_SECRET="whsec_YOUR_STRIPE_WEBHOOK_SECRET"

# 4. Identifiants des tarifs récurrents (Facultatif - si non définis, générés automatiquement en EUR)
# Exemple: price_1OmXYZ...
STRIPE_PRICE_PRO=""
STRIPE_PRICE_PRO_PLUS=""

# =========================================================================
# CONFIGURATION ENVOI MAILS (WELCOME EMAIL)
# =========================================================================
# Serveur SMTP (Hôte, Port, Identifiants) pour envoyer les mails réels.
# Si non configuré, l'application utilise automatiquement un compte Ethereal d'essai temporaire.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="pixup.agence@gmail.com"
SMTP_PASS="YOUR_SMTP_APP_PASSWORD"
SMTP_SECURE="false"
SMTP_FROM='"The Box" <pixup.agence@gmail.com>'

# Adresse e-mail administrateur recevant une copie (Bcc) de chaque création de compte
ADMIN_NOTIFICATION_EMAIL="pixup.agence@gmail.com"

# =========================================================================
# FIREBASE ADMIN (POUR LES WEBHOOKS STRIPE CÔTÉ SERVEUR)
# =========================================================================
# Clé JSON du compte de service Firebase (Console Firebase > Paramètres du projet > Comptes de service)
# Permet au serveur de mettre à jour le plan de l'utilisateur directement lors de la réception des événements Stripe.
# (Sur Google Cloud / Cloud Run, l'authentification est automatique si non défini).
FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "...", ...}'



# =========================================================================
# TÂCHES PLANIFIÉES VERCEL (vercel.json > crons)
# =========================================================================
# Secret envoyé par Vercel aux tâches planifiées (« Authorization: Bearer ... »).
# Sans lui, la route /api/cron/purge-rate-limits refuse tout appel.
# Générer une valeur longue et aléatoire, ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# =========================================================================
# FIREBASE APP CHECK (reCAPTCHA v3) — voir lib/firebase.ts et lib/appCheck.ts
# =========================================================================
# Clé de site reCAPTCHA v3 (publique) : sans elle, App Check reste désactivé.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
# Jeton de débogage (localhost, tests e2e) : à enregistrer dans Firebase > App Check > Jetons de débogage.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=""
# "true" : les routes /api publiques refusent les requêtes sans jeton valide (sinon : simple surveillance).
APPCHECK_ENFORCE="false"
