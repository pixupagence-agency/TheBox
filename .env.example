# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =========================================================================
# STRIPE PAYMENTS CONFIGURATION
# =========================================================================
# 1. Clé secrète Stripe (tableau de bord Stripe > Développeurs > Clés API)
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_SECRET_KEY"

# 2. Clé publique Stripe (accessible côté client)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_STRIPE_PUBLISHABLE_KEY"

# 3. Secret de signature du Webhook Stripe (Stripe > Développeurs > Webhooks)
STRIPE_WEBHOOK_SECRET="whsec_YOUR_STRIPE_WEBHOOK_SECRET"

# 4. Identifiants des tarifs récurrents (Facultatif - si non définis, générés automatiquement en EUR)
# Exemple: price_1OmXYZ...
STRIPE_PRICE_PRO=""
STRIPE_PRICE_PRO_PLUS=""

# =========================================================================
# CONFIGURATION ENVOI MAILS (WELCOME EMAIL)
# =========================================================================
# Serveur SMTP (Hôte, Port, Identifiants) pour envoyer les mails réels.
# Si non configuré, l'application utilise automatiquement un compte Ethereal d'essai temporaire.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="pixup.agence@gmail.com"
SMTP_PASS="YOUR_SMTP_APP_PASSWORD"
SMTP_SECURE="false"
SMTP_FROM='"The Box" <pixup.agence@gmail.com>'

# Adresse e-mail administrateur recevant une copie (Bcc) de chaque création de compte
ADMIN_NOTIFICATION_EMAIL="pixup.agence@gmail.com"

