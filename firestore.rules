rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'zWx5tcF4sehRBpuGtQ0rqg2WXMf2' ||
        (request.auth.token.keys().hasAll(['email']) && request.auth.token.email == 'pixup.agence@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasUnchangedCreatedAt() {
      return !('createdAt' in existing()) || !('createdAt' in incoming()) || incoming().createdAt == existing().createdAt;
    }

    function hasSafeAdminStatus() {
      return isSuperAdmin() || 
        ((!('isAdmin' in incoming()) || incoming().isAdmin == false) && (!('isAdmin' in existing()) || existing().isAdmin == false)) ||
        (('isAdmin' in incoming()) && ('isAdmin' in existing()) && incoming().isAdmin == existing().isAdmin);
    }

    // Champs d'abonnement : écrits uniquement par le serveur (webhook Stripe, Admin SDK) ou un super admin.
    // Un coach ne peut pas s'attribuer lui-même une formule payante ni modifier ses données Stripe.
    function billingKeys() {
      return ['stripeCustomerId', 'stripeSubscriptionId', 'stripeStatus', 'cancelAtPeriodEnd', 'accessEndsAt'];
    }

    function hasSafeBillingOnCreate() {
      return isSuperAdmin() || (
        !incoming().keys().hasAny(billingKeys()) &&
        (!('activePlan' in incoming()) || incoming().activePlan == 'free') &&
        incoming().get('trialBonusDays', 0) == 0
      );
    }

    function hasSafeBillingOnUpdate() {
      return isSuperAdmin() || (
        !incoming().diff(existing()).affectedKeys().hasAny(billingKeys()) &&
        // la formule peut rester identique ou repasser en gratuit, jamais monter
        (!incoming().diff(existing()).affectedKeys().hasAny(['activePlan']) || incoming().activePlan == 'free') &&
        // les jours d'essai offerts ne peuvent pas être modifiés par le coach (0 si absent)
        incoming().get('trialBonusDays', 0) == existing().get('trialBonusDays', 0)
      );
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().id == userId &&
        (incoming().isAdmin != true || isSuperAdmin()) &&
        hasSafeBillingOnCreate() &&
        (!('email' in incoming()) || (incoming().email is string && incoming().email.size() <= 254)) &&
        (!('firstName' in incoming()) || (incoming().firstName is string && incoming().firstName.size() <= 100)) &&
        (!('lastName' in incoming()) || (incoming().lastName is string && incoming().lastName.size() <= 100));

      allow update: if (isOwner(userId) || isSuperAdmin()) &&
        isValidId(userId) &&
        incoming().id == existing().id &&
        hasSafeAdminStatus() &&
        hasSafeBillingOnUpdate() &&
        hasUnchangedCreatedAt() &&
        (!('email' in incoming()) || (incoming().email is string && incoming().email.size() <= 254)) &&
        (!('firstName' in incoming()) || (incoming().firstName is string && incoming().firstName.size() <= 100)) &&
        (!('lastName' in incoming()) || (incoming().lastName is string && incoming().lastName.size() <= 100));

      allow delete: if isSuperAdmin();
    }

    // --- Admins Whitelist ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // --- Tactics / Playbooks ---
    match /tactics/{tacticId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());

      allow create: if isSignedIn() &&
        isValidId(tacticId) &&
        (incoming().userId == request.auth.uid || isSuperAdmin()) &&
        (!('name' in incoming()) || (incoming().name is string && incoming().name.size() <= 200)) &&
        (!('notes' in incoming()) || (incoming().notes is string && incoming().notes.size() <= 10000)) &&
        (!('payload' in incoming()) || (incoming().payload is string && incoming().payload.size() <= 1048576));

      allow update: if isSignedIn() &&
        isValidId(tacticId) &&
        (existing().userId == request.auth.uid || isSuperAdmin()) &&
        (incoming().userId == existing().userId || isSuperAdmin()) &&
        hasUnchangedCreatedAt() &&
        (!('name' in incoming()) || (incoming().name is string && incoming().name.size() <= 200)) &&
        (!('notes' in incoming()) || (incoming().notes is string && incoming().notes.size() <= 10000)) &&
        (!('payload' in incoming()) || (incoming().payload is string && incoming().payload.size() <= 1048576));

      allow delete: if isSignedIn() &&
        isValidId(tacticId) &&
        (existing().userId == request.auth.uid || isSuperAdmin());
    }

    // --- Matches & Live Match Sheets ---
    match /matches/{matchId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());

      allow create: if isSignedIn() &&
        isValidId(matchId) &&
        (incoming().userId == request.auth.uid || isSuperAdmin()) &&
        (!('name' in incoming()) || (incoming().name is string && incoming().name.size() <= 200)) &&
        (!('tacticalNotes' in incoming()) || (incoming().tacticalNotes is string && incoming().tacticalNotes.size() <= 10000)) &&
        (!('dataPayload' in incoming()) || (incoming().dataPayload is string && incoming().dataPayload.size() <= 1048576));

      allow update: if isSignedIn() &&
        isValidId(matchId) &&
        (existing().userId == request.auth.uid || isSuperAdmin()) &&
        (incoming().userId == existing().userId || isSuperAdmin()) &&
        hasUnchangedCreatedAt() &&
        (!('name' in incoming()) || (incoming().name is string && incoming().name.size() <= 200)) &&
        (!('tacticalNotes' in incoming()) || (incoming().tacticalNotes is string && incoming().tacticalNotes.size() <= 10000)) &&
        (!('dataPayload' in incoming()) || (incoming().dataPayload is string && incoming().dataPayload.size() <= 1048576));

      allow delete: if isSignedIn() &&
        isValidId(matchId) &&
        (existing().userId == request.auth.uid || isSuperAdmin());
    }

    // --- Teams & Rosters ---
    match /teams/{teamId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());

      allow create: if isSignedIn() &&
        isValidId(teamId) &&
        (incoming().userId == request.auth.uid || isSuperAdmin()) &&
        (!('name' in incoming()) || (incoming().name is string && incoming().name.size() <= 200));

      allow update: if isSignedIn() &&
        isValidId(teamId) &&
        (existing().userId == request.auth.uid || isSuperAdmin()) &&
        (incoming().userId == existing().userId || isSuperAdmin()) &&
        hasUnchangedCreatedAt() &&
        (!('name' in incoming()) || (incoming().name is string && incoming().name.size() <= 200));

      allow delete: if isSignedIn() &&
        isValidId(teamId) &&
        (existing().userId == request.auth.uid || isSuperAdmin());
    }

    // --- Données du coach synchronisées (équipes, effectifs, matchs, notes, événements…) ---
    // Une clé = un ou plusieurs documents {key, part, parts, value, updatedAt} (découpage < 1 Mo).
    match /userData/{userId}/entries/{entryId} {
      allow read, delete: if isOwner(userId) || isSuperAdmin();

      allow create, update: if isOwner(userId) &&
        isValidId(entryId) &&
        incoming().keys().hasOnly(['key', 'part', 'parts', 'value', 'updatedAt']) &&
        incoming().key is string && incoming().key.size() <= 110 &&
        incoming().part is int && incoming().part >= 0 &&
        incoming().parts is int && incoming().parts > incoming().part && incoming().parts <= 50 &&
        incoming().value is string && incoming().value.size() <= 1000000 &&
        incoming().updatedAt is int;
    }

    // --- Global App Config (Admin Managed) ---
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin() && isValidId(configId);
    }
  }
}
