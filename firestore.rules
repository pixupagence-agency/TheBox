rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Adresse super admin uniquement si elle est confirmée (connexion Google) : sinon n'importe qui
    // pourrait créer un compte e-mail/mot de passe avec cette adresse et obtenir les droits.
    function isSuperAdmin() {
      return isSignedIn() && (
        (request.auth.token.get('email', '') == 'pixup.agence@gmail.com' &&
          request.auth.token.get('email_verified', false) == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Club de la page publique (liveClubs/{slug}) appartenant au coach connecté
    function ownsClub(slug) {
      return slug is string && isValidId(slug) &&
        get(/databases/$(database)/documents/liveClubs/$(slug)).data.ownerUid == request.auth.uid;
    }

    // --- Structure des documents publics du mode Live (lib/live/model.ts, LiveMatchDoc) ---
    // Tout ce qui est écrit ici s'affiche sur des pages publiques : champs connus, types et tailles bornés.
    // (Le contenu de chaque fait de match n'est pas inspectable par les règles : leur nombre est borné.)
    function optStr(d, k, max) {
      return !(k in d) || (d[k] is string && d[k].size() <= max);
    }

    function optNum(d, k) {
      return !(k in d) || d[k] is number;
    }

    // Champs d'un match écrits par l'app du coach (les réactions sont écrites par le serveur seulement)
    function liveMatchKeys() {
      return ['ownerUid', 'clubSlug', 'clubName', 'teamId', 'teamName', 'home', 'away', 'competition',
              'date', 'time', 'dateTime', 'venue', 'coachNote', 'sport', 'periods', 'periodSeconds',
              'breakAfterIndex', 'status', 'period', 'score', 'clock', 'events', 'lineup', 'hostSeenAt',
              'createdAt', 'updatedAt', 'finishedAt'];
    }

    // Résumé publié dans l'index du club : sans composition, réactions ni identifiant du coach (lib/live/privacy.ts)
    function clubMatchKeys() {
      return liveMatchKeys().removeAll(['ownerUid', 'lineup', 'hostSeenAt']);
    }

    function liveFieldsOk(d) {
      return optStr(d, 'clubSlug', 64) && optStr(d, 'clubName', 200) && optStr(d, 'teamId', 128) &&
        optStr(d, 'teamName', 200) && optStr(d, 'home', 200) && optStr(d, 'away', 200) &&
        optStr(d, 'competition', 200) && optStr(d, 'date', 20) && optStr(d, 'time', 10) &&
        optStr(d, 'dateTime', 80) && optStr(d, 'venue', 300) && optStr(d, 'coachNote', 600) &&
        optStr(d, 'sport', 40) && optStr(d, 'period', 20) &&
        (!('status' in d) || d.status in ['scheduled', 'live', 'halftime', 'finished']) &&
        (!('periods' in d) || (d.periods is list && d.periods.size() <= 8)) &&
        optNum(d, 'periodSeconds') && optNum(d, 'breakAfterIndex') && optNum(d, 'hostSeenAt') &&
        optNum(d, 'createdAt') && optNum(d, 'updatedAt') &&
        (!('finishedAt' in d) || d.finishedAt == null || d.finishedAt is number) &&
        (!('score' in d) || (d.score is map && d.score.keys().hasOnly(['home', 'away']) &&
          d.score.get('home', 0) is number && d.score.get('away', 0) is number)) &&
        (!('clock' in d) || (d.clock is map && d.clock.keys().hasOnly(['elapsed', 'runningSince']))) &&
        (!('events' in d) || (d.events is list && d.events.size() <= 1000)) &&
        (!('lineup' in d) || (d.lineup is map && d.lineup.keys().hasOnly(['onPitch', 'bench']) &&
          d.lineup.get('onPitch', []) is list && d.lineup.get('onPitch', []).size() <= 40 &&
          d.lineup.get('bench', []) is list && d.lineup.get('bench', []).size() <= 60));
    }

    // Mise à jour : seuls les champs modifiés doivent être connus (tolère d'éventuels anciens champs)
    function changesOnly(keys) {
      return incoming().diff(existing()).affectedKeys().hasOnly(keys);
    }

    // Logo d'un club : image intégrée uniquement (jamais une adresse externe, qui pisterait les visiteurs)
    function validClub(d) {
      return d.keys().hasOnly(['ownerUid', 'name', 'logo', 'updatedAt']) &&
        optStr(d, 'name', 200) && optNum(d, 'updatedAt') &&
        (!('logo' in d) || (d.logo is string && d.logo.size() <= 300000 &&
          (d.logo == '' || d.logo.matches('^data:image/(png|jpeg|webp);base64,.*'))));
    }

    // Accès télécommande (lib/live/client.ts, regenerateEditorAccess) : code de 6 caractères, empreinte SHA-256
    function validEditorKey(d) {
      return d.keys().hasOnly(['ownerUid', 'token', 'tokenHash', 'code', 'revoked', 'createdAt']) &&
        optStr(d, 'token', 64) &&
        (!('tokenHash' in d) || (d.tokenHash is string && d.tokenHash.matches('^[0-9a-f]{64}$'))) &&
        (!('code' in d) || (d.code is string && d.code.matches('^[A-Z0-9]{6}$'))) &&
        (!('revoked' in d) || d.revoked is bool) && optNum(d, 'createdAt');
    }

    function hasUnchangedCreatedAt() {
      return !('createdAt' in existing()) || !('createdAt' in incoming()) || incoming().createdAt == existing().createdAt;
    }

    function hasSafeAdminStatus() {
      return isSuperAdmin() || 
        ((!('isAdmin' in incoming()) || incoming().isAdmin == false) && (!('isAdmin' in existing()) || existing().isAdmin == false)) ||
        (('isAdmin' in incoming()) && ('isAdmin' in existing()) && incoming().isAdmin == existing().isAdmin);
    }

    // Champs d'abonnement : écrits uniquement par le serveur (webhook Stripe, Admin SDK) ou un super admin.
    // Un coach ne peut pas s'attribuer lui-même une formule payante ni modifier ses données Stripe.
    function billingKeys() {
      return ['stripeCustomerId', 'stripeSubscriptionId', 'stripeStatus', 'cancelAtPeriodEnd', 'accessEndsAt',
              'hasHadSubscription', 'trialEndsAt', 'freeSince',
              'deletionScheduledAt', 'deletionRequestedAt', 'deletionStoppedRenewal'];
    }

    // Accès aux fonctions PRO (formule payante, essai en cours ou admin), calculé depuis le profil
    // tenu à jour par le serveur (lib/accountStatus.ts). Sans accès, le coach ne peut plus enregistrer
    // d'équipes, de matchs, de notes ni de schémas en ligne (lecture et suppression restent possibles).
    function hasProAccess(userId) {
      // isSuperAdmin() en dernier : son exists() sur admins/ compte une lecture, inutile pour un coach PRO ou en essai
      let u = get(/databases/$(database)/documents/users/$(userId)).data;
      return u.get('isAdmin', false) == true ||
        u.get('activePlan', 'free') in ['pro', 'mensuel', 'pro_plus', 'club', 'annuel'] ||
        (u.get('hasHadSubscription', false) != true &&
          u.get('trialEndsAt', null) is timestamp &&
          u.trialEndsAt > request.time) ||
        isSuperAdmin();
    }

    function hasSafeBillingOnCreate() {
      return isSuperAdmin() || (
        !incoming().keys().hasAny(billingKeys()) &&
        (!('activePlan' in incoming()) || incoming().activePlan == 'free') &&
        incoming().get('trialBonusDays', 0) == 0
      );
    }

    function hasSafeBillingOnUpdate() {
      return isSuperAdmin() || (
        !incoming().diff(existing()).affectedKeys().hasAny(billingKeys()) &&
        // la formule peut rester identique ou repasser en gratuit, jamais monter
        (!incoming().diff(existing()).affectedKeys().hasAny(['activePlan']) || incoming().activePlan == 'free') &&
        // les jours d'essai offerts ne peuvent pas être modifiés par le coach (0 si absent)
        incoming().get('trialBonusDays', 0) == existing().get('trialBonusDays', 0)
      );
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();

      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().id == userId &&
        (incoming().get('isAdmin', false) != true || isSuperAdmin()) &&
        hasSafeBillingOnCreate() &&
        (!('email' in incoming()) || (incoming().email is string && incoming().email.size() <= 254)) &&
        (!('firstName' in incoming()) || (incoming().firstName is string && incoming().firstName.size() <= 100)) &&
        (!('lastName' in incoming()) || (incoming().lastName is string && incoming().lastName.size() <= 100)) &&
        (!('clubLogo' in incoming()) || (incoming().clubLogo is string && incoming().clubLogo.size() <= 300000 && (incoming().clubLogo == '' || incoming().clubLogo.matches('^data:image/(png|jpeg|webp);base64,.*')))) &&
        (!('showLogoOnPitch' in incoming()) || incoming().showLogoOnPitch is bool);

      allow update: if (isOwner(userId) || isSuperAdmin()) &&
        isValidId(userId) &&
        incoming().id == existing().id &&
        hasSafeAdminStatus() &&
        hasSafeBillingOnUpdate() &&
        hasUnchangedCreatedAt() &&
        (!('email' in incoming()) || (incoming().email is string && incoming().email.size() <= 254)) &&
        (!('firstName' in incoming()) || (incoming().firstName is string && incoming().firstName.size() <= 100)) &&
        (!('lastName' in incoming()) || (incoming().lastName is string && incoming().lastName.size() <= 100)) &&
        (!('clubLogo' in incoming()) || (incoming().clubLogo is string && incoming().clubLogo.size() <= 300000 && (incoming().clubLogo == '' || incoming().clubLogo.matches('^data:image/(png|jpeg|webp);base64,.*')))) &&
        (!('showLogoOnPitch' in incoming()) || incoming().showLogoOnPitch is bool);

      allow delete: if isSuperAdmin();
    }

    // --- Admins Whitelist ---
    // Lue par le serveur (Admin SDK) et par isSuperAdmin() via exists(), qui ne dépend pas de ces droits :
    // un compte ne voit que sa propre entrée, la liste complète est réservée aux super admins.
    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // --- Anciens schémas v1 (copiés vers users/{uid}/schemas, supprimés 60 jours après la migration) ---
    match /tactics/{tacticId} {
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isSuperAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin());

      allow create: if isSignedIn() &&
        isValidId(tacticId) &&
        (incoming().userId == request.auth.uid || isSuperAdmin()) &&
        hasProAccess(request.auth.uid) &&
        (!('name' in incoming()) || (incoming().name is string && incoming().name.size() <= 200)) &&
        (!('notes' in incoming()) || (incoming().notes is string && incoming().notes.size() <= 10000)) &&
        (!('payload' in incoming()) || (incoming().payload is string && incoming().payload.size() <= 1048576));

      allow update: if isSignedIn() &&
        isValidId(tacticId) &&
        (existing().userId == request.auth.uid || isSuperAdmin()) &&
        hasProAccess(request.auth.uid) &&
        (incoming().userId == existing().userId || isSuperAdmin()) &&
        hasUnchangedCreatedAt() &&
        (!('name' in incoming()) || (incoming().name is string && incoming().name.size() <= 200)) &&
        (!('notes' in incoming()) || (incoming().notes is string && incoming().notes.size() <= 10000)) &&
        (!('payload' in incoming()) || (incoming().payload is string && incoming().payload.size() <= 1048576));

      allow delete: if isSignedIn() &&
        isValidId(tacticId) &&
        (existing().userId == request.auth.uid || isSuperAdmin());
    }

    // --- Données structurées du coach (v2) : users/{uid}/teams, players, matches, matchData, settings, schemas ---
    // Privées par construction : seul le propriétaire (ou un super admin) y accède.
    match /users/{userId}/{coll}/{docId} {
      allow read, delete: if isOwner(userId) || isSuperAdmin();

      allow create, update: if (isOwner(userId) || isSuperAdmin()) &&
        hasProAccess(userId) &&
        isValidId(docId) &&
        coll in ['teams', 'players', 'matches', 'matchData', 'settings', 'schemas'] &&
        (!('key' in incoming()) || (incoming().key is string && incoming().key.size() <= 200)) &&
        (!('raw' in incoming()) || (incoming().raw is string && incoming().raw.size() <= 1000000)) &&
        (!('payload' in incoming()) || (incoming().payload is string && incoming().payload.size() <= 1048576)) &&
        (!('name' in incoming()) || (incoming().name is string && incoming().name.size() <= 500)) &&
        (!('userId' in incoming()) || incoming().userId == userId);
    }

    // --- Anciennes données v1 (blocs bruts) : conservées 60 jours après la migration, puis supprimées ---
    // Une clé = un ou plusieurs documents {key, part, parts, value, updatedAt} (découpage < 1 Mo).
    match /userData/{userId}/entries/{entryId} {
      allow read, delete: if isOwner(userId) || isSuperAdmin();

      allow create, update: if isOwner(userId) &&
        hasProAccess(userId) &&
        isValidId(entryId) &&
        incoming().keys().hasOnly(['key', 'part', 'parts', 'value', 'updatedAt']) &&
        incoming().key is string && incoming().key.size() <= 110 &&
        incoming().part is int && incoming().part >= 0 &&
        incoming().parts is int && incoming().parts > incoming().part && incoming().parts <= 50 &&
        incoming().value is string && incoming().value.size() <= 1000000 &&
        incoming().updatedAt is int;
    }

    // --- Mode Live déporté (lib/live/model.ts) ---
    // Document public d'un match : lu par quiconque a son lien (QR du match), écrit par le coach propriétaire.
    // RGPD (joueurs souvent mineurs) : la collection n'est pas listable, on ne peut pas parcourir les
    // matchs de tous les clubs ; la page du club passe par son index liveClubs/{slug}/matches.
    // La télécommande (adjoint sans compte) écrit via l'API serveur (Admin SDK), jamais directement.
    match /liveMatches/{publicId} {
      allow get: if true;
      allow list: if false;

      // Le match ne peut être rattaché qu'à un club du même coach : sinon sa page afficherait le nom et
      // le logo d'un autre club, et la télécommande l'inscrirait dans l'index de ce club.
      // Contrôlé à la création et au changement de club seulement (une lecture de moins à chaque mise à jour du score).
      allow create: if isSignedIn() &&
        isValidId(publicId) &&
        incoming().ownerUid == request.auth.uid &&
        hasProAccess(request.auth.uid) &&
        incoming().keys().hasOnly(liveMatchKeys()) && liveFieldsOk(incoming()) &&
        ownsClub(incoming().clubSlug);

      allow update: if isSignedIn() &&
        existing().ownerUid == request.auth.uid &&
        incoming().ownerUid == existing().ownerUid &&
        changesOnly(liveMatchKeys().removeAll(['ownerUid', 'createdAt'])) && liveFieldsOk(incoming()) &&
        (incoming().clubSlug == existing().clubSlug || ownsClub(incoming().clubSlug));

      allow delete: if isSignedIn() && (existing().ownerUid == request.auth.uid || isSuperAdmin());

      // Actions saisies à la télécommande : créées par le serveur, appliquées puis marquées par le coach
      match /commands/{cmdId} {
        allow read, update, delete: if isSignedIn() &&
          get(/databases/$(database)/documents/liveMatches/$(publicId)).data.ownerUid == request.auth.uid;
        allow create: if false;
      }
    }

    // Accès éditeur (télécommande) : empreinte du jeton secret et code, privés au coach
    match /liveEditorKeys/{publicId} {
      allow get: if isSignedIn() && (resource == null || existing().ownerUid == request.auth.uid);
      allow list: if false;
      allow create: if isSignedIn() && isValidId(publicId) && incoming().ownerUid == request.auth.uid && validEditorKey(incoming());
      allow update: if isSignedIn() && existing().ownerUid == request.auth.uid && incoming().ownerUid == request.auth.uid &&
        validEditorKey(incoming());
      allow delete: if isSignedIn() && (existing().ownerUid == request.auth.uid || isSuperAdmin());
    }

    // Page publique du club (QR général) : nom et logo, lus par quiconque a l'adresse du club.
    // Liste : uniquement ses propres clubs (recherche de sa page par le coach, lib/live/client.ts).
    match /liveClubs/{slug} {
      allow get: if true;
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn() && isValidId(slug) && incoming().ownerUid == request.auth.uid && validClub(incoming());
      allow update: if isSignedIn() && existing().ownerUid == request.auth.uid && incoming().ownerUid == request.auth.uid &&
        validClub(incoming());
      allow delete: if isSignedIn() && (existing().ownerUid == request.auth.uid || isSuperAdmin());

      // Index des matchs du club (résumés sans composition) : lisible avec l'adresse du club,
      // écrit par le coach propriétaire du club (et par l'API de la télécommande, Admin SDK)
      match /matches/{publicId} {
        allow read: if true;
        allow create: if isSignedIn() && isValidId(publicId) &&
          get(/databases/$(database)/documents/liveClubs/$(slug)).data.ownerUid == request.auth.uid &&
          incoming().keys().hasOnly(clubMatchKeys()) && liveFieldsOk(incoming());
        allow update: if isSignedIn() &&
          get(/databases/$(database)/documents/liveClubs/$(slug)).data.ownerUid == request.auth.uid &&
          changesOnly(clubMatchKeys()) && liveFieldsOk(incoming());
        allow delete: if isSignedIn() &&
          get(/databases/$(database)/documents/liveClubs/$(slug)).data.ownerUid == request.auth.uid;
      }
    }

    // --- Documents légaux (lib/legal) : lecture publique, publication par le super admin ---
    function validLegalDoc(d) {
      return d.keys().hasOnly(['intro', 'sections', 'updatedAt', 'updatedBy', 'version']) &&
        d.keys().hasAll(['intro', 'sections', 'updatedAt', 'version']) &&
        d.intro is string && d.intro.size() <= 4000 &&
        d.sections is list && d.sections.size() >= 1 && d.sections.size() <= 60 &&
        d.updatedAt is string && d.version is int && d.version >= 1 &&
        (!('updatedBy' in d) || d.updatedBy == null || d.updatedBy is string);
    }

    match /legalDocs/{docId} {
      allow read: if true;
      allow create, update: if isSuperAdmin() &&
        docId in ['cgu', 'cgv', 'mentions', 'privacy', 'dpa'] &&
        validLegalDoc(incoming()) &&
        ((resource == null && incoming().version == 1) ||
          (resource != null && incoming().version == existing().get('version', 0) + 1));

      // Versions publiées, conservées telles quelles (preuve du texte en vigueur à une date)
      match /history/{version} {
        allow read: if isSuperAdmin();
        allow create: if isSuperAdmin() && validLegalDoc(incoming()) && version == string(incoming().version);
      }
    }

    // --- Global App Config (Admin Managed) ---
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isSuperAdmin() && isValidId(configId) && configId != 'maintenance';
    }

    // Mode maintenance (lib/maintenance.ts) : réservé au compte super admin de la plateforme
    match /app_config/maintenance {
      allow write: if isSignedIn() &&
        request.auth.token.get('email', '') == 'pixup.agence@gmail.com' &&
        request.auth.token.get('email_verified', false) == true &&
        incoming().keys().hasOnly(['enabled', 'message', 'updatedAt', 'updatedBy']) &&
        incoming().enabled is bool &&
        incoming().message is string && incoming().message.size() <= 500 &&
        incoming().updatedAt is string;
    }
  }
}
